/*
usage:

dither -xvt c grass.dh [action] [config.json]

actions:
  show      visualize simulation
  dump      write renders to file
  showdump  both

about dither programming language: 
https://github.com/LingDong-/dither-lang
*/

include "std/rand"
include "std/geom"
include "std/math"
include "std/list"
include "std/vec"
include "std/io"
include "std/drw"
include "std/img"
include "std/arr"
include "std/str"
include "std/exch"
include "std/sys"

action := sys.argv()[0];
DO_ANIM := 0;
DO_WRITE := 0;
if (action == "show"){
  DO_ANIM = 1;
}else if (action == "dump"){
  DO_WRITE = 1;
}else if (action == "showdump"){
  DO_ANIM = 1;
  DO_WRITE = 1;
}

pth_cfg := sys.argv()[1];
txt_cfg := str.decode(io.read_file(pth_cfg),"utf-8");
cfg := (exch.decode[exch.JSON](txt_cfg)).data as dict[str,exch.JSON];

DO_CIRC_CAP  := cfg["do_circ_cap"].data as f32 as i32;
MIN_NEEDLE   := cfg["min_needle"].data as f32;
MUL_NEEDLE   := cfg["mul_needle"].data as f32;
PRESHRINK    := cfg["preshrink"].data as f32;
SLANT        := cfg["slant"].data as f32;
PINCUSHION   := cfg["pincushion"].data as f32;
MIN_SPREAD_X := cfg["min_spread_x"].data as f32;
MIN_SPREAD_Y := cfg["min_spread_y"].data as f32;
MAX_SPREAD_X := cfg["max_spread_x"].data as f32;
MAX_SPREAD_Y := cfg["max_spread_y"].data as f32;
MUL_SPREAD_X := cfg["mul_spread_x"].data as f32;
MUL_SPREAD_Y := cfg["mul_spread_y"].data as f32;
ACCEL        := cfg["accel"].data as f32;
DAMP         := cfg["damp"].data as f32;
OVERTIME     := cfg["overtime"].data as f32 as i32;
FPSTROKE     := cfg["fpstroke"].data as f32 as i32;
MIN_DIP      := cfg["min_dip"].data as f32;
MAX_DIP      := cfg["max_dip"].data as f32;
POW_Z        := cfg["pow_z"].data as f32;
MUL_Z        := cfg["mul_z"].data as f32;
ADD_Z        := cfg["add_z"].data as f32;

hz := str.decode(io.read_file("mmhz_trad.hershez.txt"),'utf-8').split("\n")

func parse_hf(s:str):list[list[vec[f32,3]]]{
  ps := list[list[vec[f32,3]]]{list[vec[f32,3]]{}};
  for (i := 10; i < s.length(); i+=3){
    if (s[i] == ' ' && s[i+1] == 'R'){
      ps.push(list[vec[f32,3]]{});
    }else{
      ps[ps.length()-1].push({(s[i]-'R')*0.75 + 32, (s[i+1]-'R')*0.75 + 32, (s[i+2]-'0')*0.5})
    }
  }
  return ps;
}

drw.size(1024,1024);

func draw_polys(polys:list[list[vec[f32,3]]]){
  drw.begin_shape();
  for (i := 0; i < polys.length(); i++){
    for (j := 0; j < polys[i].length(); j++){
      drw.vertex(...polys[i][j].xy);
    }
    drw.next_contour(0);
  }
  drw.end_shape();
  for (i := 0; i < polys.length(); i++){
    for (j := 0; j < polys[i].length(); j++){
      drw.circle(...polys[i][j].xy,2);
    }
  }
}


func vang(a:vec[f32,2],b:vec[f32,2]):f32{
  cross := a.x*b.y - a.y*b.x
  dot   := a.x*b.x + a.y*b.y
  angle := math.atan2(cross, dot);
  return angle;
}


func bstroke(poly:list[vec[f32,3]],dip:f32){
  L := list[vec[f32,2]]{};
  R := list[vec[f32,2]]{};
  for (i := 0; i < poly.length(); i++){
    p1 := poly[i].xy;
    ds := list[vec[f32,2]]{};
    if (i < poly.length()-1){
      p2 := poly[i+1].xy;
      d := (p2-p1).dir();
      ds.push({-d.y,d.x}*poly[i].z)
    }else if (i>0){
      p0 := poly[i-1].xy;
      d := (p1-p0).dir();
      ds.push({-d.y,d.x}*poly[i].z)
    }
    if (ds.length()>1){
      ds[0] = ds[0]*0.5+ds.pop()*0.5
    }
    L.push(p1-ds[0])
    R.push(p1+ds[0])
  }
  for (i := 0; i < poly.length()-1; i++){

    l := (poly[i].xy-poly[i+1].xy).mag();
    drw.stroke(0);
    drw.stroke_weight(1);
    drw.no_fill();
    n : i32 = ((L[i]-R[i]).mag()+(L[i+1]-R[i+1]).mag())*0.8;
    
    for (j := 0; j < n; j++){
      t := (j as f32)/(n-1)
      a := (L[i]*(1-t)+R[i]*t);
      b := (L[i+1]*(1-t)+R[i+1]*t);
      // drw.line(...a,...b)
      ll : i32 = math.max(math.round((a-b).mag()/2),1)*2;
      drw.begin_shape();
      for (k := 0; k <= ll; k+=2){
        s := (k as f32)/ll;
        drw.vertex(...(a*(1-s)+b*s));
        if (rand.random()>1.1+dip-l*l*0.002 && (math.sin(j*123.45)*6.789)%1.0<0.5){
          drw.end_shape();
          drw.begin_shape();
        }
      }
      drw.end_shape();
    }
    if (i==0||i==poly.length()-2||math.abs(vang(poly[i].xy-poly[i-1].xy, poly[i+1].xy-poly[i].xy)) > math.PI/2){
      drw.fill(0,0,0);
      if (DO_CIRC_CAP) drw.circle(...((L[i]+R[i])*0.5),(L[i]-R[i]).mag())
    }
  }
}


pg := drw.create_graphics(1024,1536);


for (chr := 0; chr < hz.length(); chr +=1){

  polys := parse_hf(hz[chr])

  for (i := 0; i < polys.length(); i++){
    for (j := 0; j < polys[i].length(); j++){
      d := polys[i][j].xy-{28.,28};
      polys[i][j] = {28.,28.,0.} + {d.x*PRESHRINK, d.y*PRESHRINK, polys[i][j].z};
      polys[i][j] += d.mag() * d.mag() * d.dir() * PINCUSHION;
      polys[i][j] += {0,-polys[i][j].x*SLANT,0.}
    }
  }


  ymax := 64.0;

  last := polys[polys.length()-1].map(func (x:vec[f32,3]):vec[f32,2]{return x.xy})
  [cen,ext,axs] := geom.bbox(last,geom.MODE_ORIENTED|1);
  if (ext.x > MIN_NEEDLE && ext.x / ext.y > 10.0 && axs[2] / axs[0] > 10.0 && last[0].y < last[last.length()-1].y){
    pp := polys[polys.length()-1];
    top := last[0].y;
    bot := last[last.length()-1].y;
    zmax := 0.0
    while(pp[pp.length()-1].y > top + 15){
      zmax >?= pp[pp.length()-1].z;
      pp.pop()
    }
    for (i:=0;i<pp.length();i++){
      zmax >?= pp[i].z*0.67;
    }
    sw := math.max(MIN_NEEDLE,math.min(ext.x*MUL_NEEDLE,38.0));
    // io.println(sw)
    top = pp[pp.length()-1].y;
    bot = bot + sw
    for (i := top; i < bot; i += 10.0){
      t := (i-top)/(bot-top);
      pp.push({pp[pp.length()-1].x, i, zmax*math.cos( t*math.PI*0.5 )**0.2})
    }
    ymax += sw
  }else{
    // continue
  }


  pg.begin();
  drw.background(1);
  drw.no_fill()

  draw_polys(polys)
  pg.end();
  pg.draw(0,0)

  cplx := 0.0;
  for (i := 0; i < polys.length(); i++) cplx += polys[i].length();
  for (i := 0; i < polys.length(); i++){
    for (j := 0; j < polys[i].length(); j++){
      mulx := math.min(MAX_SPREAD_X,MIN_SPREAD_X+cplx*MUL_SPREAD_X);
      muly := math.min(MAX_SPREAD_Y,MIN_SPREAD_Y+cplx*MUL_SPREAD_Y);
      polys[i][j] = (polys[i][j]-{32.,32.,0.}) * {mulx,muly,1} +{32.,32.,0.}
    }
  }

  pos := (polys[0][0]*0.75+{16.,2.,0.}*0.25)*{1.,1.,0.}
  vel := {0.,0.0,0.}
  idx := 0;
  jdx := 0;
  frame := 0;
  trg := polys[0][0];
  done := 0;

  out := list[vec[f32,3]]{}
  while(1){
    pg.begin();
    if (done<2){
      trg = trg * 0.5 + polys[idx][jdx]*0.5;
    }else{
      trg = (polys[idx][jdx] * 0.5 + {32.0,ymax,0.0}*0.5)*{1.,1.,0.};
      
    }
    dir := (trg - pos).dir();
    l := (trg - pos).mag();
    vel += dir*l*ACCEL;
    pos += vel;
    vel *= DAMP;
    if (pos.z<0.0) pos *= {1.,1.,0.}

    drw.fill(1,0,1)
    drw.no_stroke()
    drw.circle(...(polys[idx][jdx]*14+{64.,96.,3.}));
    
    if (frame % FPSTROKE==(FPSTROKE-1)){
      jdx++;
      if (jdx >= polys[idx].length()){
        idx++;
        jdx=0; 
      }
      
    }
    frame++;
    drw.fill(0,0,1)
    drw.no_stroke()
    drw.circle(...(trg*14+{64.,96.,0.}));
    
    drw.fill(1,0,0)
    drw.no_stroke()
    drw.circle(...(pos*14+{64.,96.,0.}));

    out.push(pos*14+{64.,96.,0.});
    
    pg.end();

    if (DO_ANIM){
      pg.draw(0,0)
      drw.poll();
    }

    if (idx >= polys.length()){
      idx = polys.length()-1;
      jdx = polys[idx].length()-1;
      done ++;
    }
    if (done > OVERTIME)break
  }

  dip := rand.random(MIN_DIP,MAX_DIP)
  for (i:=0;i<out.length();i++){
    ({x,y,z}) := out[i];
    out[i] = {x,y,(z**POW_Z)*MUL_Z*(1+dip)+ADD_Z}
  }
  pg.begin();
  drw.background(1)
  bstroke(out,dip)
  pg.end();

  if (DO_WRITE){
    fn := hz[chr].slice(0,5)
    io.write_file("render/%{fn}.png",img.encode("png",pg.read_pixels()))
  }
  
  if (DO_ANIM){
    for(i:=0;i<500;i++){
      pg.draw(0,0)
      e := drw.poll();
      if (e.type==win.KEY_PRESSED&&e.key==' '){
        break;
      }
    }
  }else{
    pg.draw(0,0)
    e := drw.poll();
  }
}
